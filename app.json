{
  "expo": {
    "name": "almacal",
    "slug": "almacal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/almacal.png",
    "scheme": "almacal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "monochromeImage": "./assets/images/almacal.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thorixrover.almacal"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/almacal.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/almacal.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "almacal",
          "organization": "alamanatra"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
